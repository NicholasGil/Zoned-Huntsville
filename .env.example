# Public site URL used for Stripe redirects and magic-link callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel (ads measurement). Public because it loads in the browser.
# Leave empty to no-op the pixel script. Set in Vercel Production
# (and Preview if you need to test ads). A change requires a new deploy.
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe Checkout + webhooks. No live keys in git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_79=
STRIPE_PRICE_ID_149=
STRIPE_PRICE_ID_349=

# Supabase Auth (magic link), Postgres, and Storage.
# Apply supabase/migrations before relying on entitlements or RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only transactional mail. Never prefix these with NEXT_PUBLIC_.
# Sample, contact, correction pings, and optional purchase receipts skip
# (forms and the Stripe webhook still succeed) when these are unset.
# Magic links still go through Supabase Auth.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO=
